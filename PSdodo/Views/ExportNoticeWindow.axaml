<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:PsExporter.Controls"
        x:Class="PsExporter.Views.ExportNoticeWindow"
        Title="导出完成" Width="364" Height="92" CanResize="False"
        WindowDecorations="None" TransparencyLevelHint="Transparent" Background="Transparent"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True">
    <controls:ContinuousBorder Margin="{StaticResource Window.ShadowMargin}"
        CornerRadius="{StaticResource Radius.ExportNotice}" BoxShadow="{StaticResource Shadow.OwnedWindow}">
        <Button x:Name="OpenNoticeDirectory" Click="OnOpenClick" Height="68" MinHeight="68" MaxHeight="68"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
            Padding="16,0,18,0" CornerRadius="{StaticResource Radius.ExportNotice}"
            Background="{DynamicResource Brush.SettingsCard}" BorderBrush="{DynamicResource Brush.OwnedWindowBorder}">
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto"
                ColumnSpacing="{StaticResource Space.Sm}" RowSpacing="{StaticResource Space.Xs}">
                <controls:ContinuousBorder Grid.RowSpan="2" Width="30" Height="30" VerticalAlignment="Center"
                    CornerRadius="{StaticResource Radius.SettingsCard}" Background="{DynamicResource Brush.StatusSurface}">
                    <Path Data="M2 8L6 12L14 4" Width="14" Height="14" Stretch="Uniform"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Stroke="{DynamicResource Brush.StatusText}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/>
                </controls:ContinuousBorder>
                <TextBlock x:Name="NoticeTitle" Grid.Column="1" Classes="setting-label" FontWeight="SemiBold"
                    VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                    AutomationProperties.LiveSetting="Polite"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock x:Name="NoticeAction" Classes="settings-caption" FontWeight="SemiBold"
                        Foreground="{DynamicResource Brush.StatusText}" VerticalAlignment="Center"/>
                    <Path Data="M1 1L5 5L1 9" Width="5" Height="10" Stretch="Uniform" VerticalAlignment="Center"
                        Stroke="{DynamicResource Brush.StatusText}" StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round"/>
                </StackPanel>
                <TextBlock x:Name="NoticePath" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                    Classes="settings-caption" Foreground="{DynamicResource Brush.TextSecondary}"
                    TextWrapping="NoWrap" TextTrimming="PathSegmentEllipsis"/>
            </Grid>
        </Button>
    </controls:ContinuousBorder>
</Window>
