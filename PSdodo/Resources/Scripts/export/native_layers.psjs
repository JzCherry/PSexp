// 图层模式复用画板导出的原生选区导出命令，由 Photoshop 决定图层/组的输出边界。
// 原生命令异步写盘；本脚本只回报目标数量，完成确认由 receipt_task + C# 文件监听负责。
const { app, core, action } = require("photoshop");
const selectedOnly = {{SELECTED_ONLY}};

async function selectLayerIds(ids) {
    const commands = ids.map((id, index) => ({
        _obj: "select", _target: [{ _ref: "layer", _id: id }], makeVisible: false,
        ...(index ? { selectionModifier: { _enum: "selectionModifierType", _value: "addToSelection" } } : {}),
        _options: { dialogOptions: "dontDisplay" }
    }));
    if (!commands.length) commands.push({
        _obj: "selectNoLayers", _target: [{ _ref: "layer", _enum: "ordinal", _value: "targetEnum" }],
        _options: { dialogOptions: "dontDisplay" }
    });
    const results = await action.batchPlay(commands, {});
    const error = results.find(item => item._obj === "error");
    if (error) throw new Error(error.message || "无法切换图层选择");
}

async function runExport() {
    if (app.documents.length === 0) throw new Error("没有打开的文档");
    let expectedFileCount = 0;
    let warning = "";
    await core.executeAsModal(async context => {
        const doc = app.activeDocument;
        const originalIds = Array.from(doc.activeLayers).map(layer => layer.id);
        const selectedIds = new Set(originalIds);
        const resolved = resolveLayerExportTargets(doc, false, selectedOnly);
        const targets = resolved.targets;
        warning = resolved.warning;
        expectedFileCount = targets.length;
        const targetIds = targets.map(layer => layer.id);
        const sameSelection = ids => ids.length === originalIds.length && ids.every(id => selectedIds.has(id));
        let failure;
        try {
            if (context.isCancelled) throw new Error("Photoshop 已取消图层导出");
            if (!sameSelection(targetIds)) await selectLayerIds(targetIds);
            const actual = new Set(Array.from(doc.activeLayers).map(layer => layer.id));
            if (actual.size !== targetIds.length || !targetIds.every(id => actual.has(id)))
                throw new Error("Photoshop 未正确选中导出对象，已停止以避免导出错误范围");
            const format = "{{FORMAT}}".toLowerCase();
            const results = await action.batchPlay([{
                _obj: "exportSelectionAsFileTypePressed",
                null: { _ref: [{ _ref: "layer", _enum: "ordinal", _value: "targetEnum" }] },
                fileType: format, quality: format === "png" ? 32 : {{QUALITY}},
                metadata: 0, destFolder: "{{EXPORT_PATH}}", sRGB: true, openWindow: false,
                _options: { dialogOptions: "dontDisplay" }
            }], {});
            const error = results.find(item => item._obj === "error");
            if (error) throw new Error(error.message || "Photoshop 原生图层导出失败");
        } catch (error) {
            failure = error;
        } finally {
            if (!context.isCancelled) {
                try {
                    if (!sameSelection(Array.from(doc.activeLayers).map(layer => layer.id))) await selectLayerIds(originalIds);
                } catch (restoreError) {
                    failure = new Error((failure ? String(failure) + "; " : "") + "恢复原图层选择失败：" + String(restoreError));
                }
            }
        }
        if (failure) throw failure;
    }, { commandName: "Export Layers" });
    return { expectedFileCount, warning };
}
