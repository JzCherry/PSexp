<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:PsExporter.Controls"
        xmlns:vm="using:PsExporter.ViewModels"
        xmlns:views="using:PsExporter.Views"
        xmlns:models="using:PsExporter.Models"
        xmlns:chrome="clr-namespace:Avalonia.Controls.Chrome;assembly=Avalonia.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="PsExporter.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/ico.ico"
        Title="{Binding ApplicationTitle}"
        Focusable="True"
        Width="{x:Static models:AppSettings.DefaultWindowWidth}"
        Height="{x:Static models:AppSettings.DefaultWindowHeight}"
        MinWidth="{x:Static models:AppSettings.MinimumWindowWidth}"
        MinHeight="{x:Static models:AppSettings.MinimumWindowHeight}"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        CanResize="True"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Classes="quality-motion"
        Topmost="{Binding EffectiveTopmost}">

    <Window.Resources>
        <ControlTheme x:Key="LayerHelpFlyoutTheme" TargetType="FlyoutPresenter">
            <Setter Property="Template">
                <ControlTemplate>
                    <controls:ContinuousBorder Margin="8" Padding="14"
                        Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Sm}" BoxShadow="{StaticResource Shadow.Menu}">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </controls:ContinuousBorder>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Window.Resources>

    <Grid x:Name="WindowSurface" ClipToBounds="True">
    <Grid x:Name="RootGrid">
        <controls:ContinuousBorder x:Name="MainContentBorder"
                Margin="{StaticResource Window.ShadowMargin}"
                BoxShadow="{StaticResource Shadow.Window}"
                Background="{StaticResource Brush.Canvas}"
                BorderThickness="0"
                CornerRadius="{StaticResource Radius.Lg}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 0. Header TitleBar -->
                <controls:ContinuousBorder Grid.Row="0"
                        Background="{StaticResource Brush.Surface}"
                        BorderThickness="0"
                        Padding="0"
                        Height="{StaticResource Control.CaptionHeight}"
                        chrome:WindowDecorationProperties.ElementRole="TitleBar">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Application Logo -->
                        <Image Margin="16,0,0,0" Width="{StaticResource Control.LogoSize}"
                               Height="{StaticResource Control.LogoSize}"
                               Source="/Assets/ico.ico"
                               Stretch="Uniform"
                               VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Margin="8,0,0,0"
                                   Text="{Binding ApplicationTitle}"
                                   TextTrimming="CharacterEllipsis"
                                   Classes="subtitle"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="2"
                                Margin="8,0,0,0" VerticalAlignment="Center"
                                Classes="tool"
                                chrome:WindowDecorationProperties.ElementRole="User"
                                Command="{Binding RefreshStatusCommand}"
                                IsEnabled="{Binding CanRefreshStatus}"
                                ToolTip.Tip="刷新 Photoshop 状态与当前文档">
                            <TextBlock x:Name="RefreshIcon"
                                       Text="{StaticResource Icon.Refresh}"
                                       Classes="icon"
                                       Foreground="{Binding IsRefreshingStatus, Converter={x:Static vm:BoolToRefreshBrushConverter.Instance}}"
                                       RenderTransformOrigin="50%,50%"/>
                        </Button>
                        <Button Grid.Column="3"
                                Margin="8,0,0,0" VerticalAlignment="Center"
                                Classes="tool pin-toggle" Classes.pinned="{Binding IsAlwaysOnTop}"
                                chrome:WindowDecorationProperties.ElementRole="User"
                                Command="{Binding ToggleAlwaysOnTopCommand}"
                                AutomationProperties.Name="切换窗口置顶">
                            <TextBlock Text="{StaticResource Icon.Pin}" Classes="icon"
                                Foreground="{Binding $parent[Button].Foreground}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Grid.Column="4"
                                Margin="8,0,8,0" VerticalAlignment="Center"
                                Classes="tool"
                                chrome:WindowDecorationProperties.ElementRole="User"
                                Command="{Binding ToggleSettingsViewCommand}"
                                IsEnabled="{Binding CanOpenOrCloseSettings}"
                                ToolTip.Tip="{Binding SettingsToggleHint}"
                                AutomationProperties.Name="{Binding SettingsToggleHint}">
                            <!-- 同一枚 28×28 按钮换皮：导出页齿轮（带更新红点），设置页返回箭头。 -->
                            <Panel Width="20" Height="20">
                                <Panel IsVisible="{Binding !IsViewSetting}">
                                    <TextBlock Text="{StaticResource Icon.Settings}" Classes="icon" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource Brush.StatusText}" HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="{Binding IsUpdateAvailable}" IsHitTestVisible="False"/>
                                </Panel>
                                <TextBlock IsVisible="{Binding IsViewSetting}" Text="{StaticResource Icon.Back}" Classes="icon" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Panel>
                        </Button>
                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Classes="tool caption" Click="OnMinimizeClick"
                                    chrome:WindowDecorationProperties.ElementRole="MinimizeButton"
                                    ToolTip.Tip="最小化" AutomationProperties.Name="最小化">
                                <Path Classes="caption-glyph" Data="M0 0H12V1H0Z" Width="12" Height="1" Stretch="Fill"
                                      Fill="{Binding $parent[Button].Foreground}"/>
                            </Button>
                            <Button Classes="tool caption close" Click="OnCloseClick"
                                    chrome:WindowDecorationProperties.ElementRole="CloseButton"
                                    ToolTip.Tip="{Binding WindowCloseHint}" AutomationProperties.Name="{Binding WindowCloseHint}">
                                <Path Classes="caption-glyph" Data="M0 0L12 12 M12 0L0 12" Width="12" Height="12" Stretch="Fill"
                                      StrokeThickness="1.3" Stroke="{Binding $parent[Button].Foreground}"/>
                            </Button>
                        </StackPanel>
                        <controls:ContinuousBorder Grid.ColumnSpan="6" Height="1" VerticalAlignment="Bottom"
                            Background="{StaticResource Brush.Divider}" IsHitTestVisible="False"/>
                    </Grid>
                </controls:ContinuousBorder>

                <!-- 1. Photoshop Connection Console -->
                <controls:ContinuousBorder Grid.Row="1"
                        Margin="16,12,16,6"
                        IsVisible="{Binding !IsViewSetting}"
                        Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.StatusBorder}"
                        BorderThickness="{StaticResource Thickness.Thin}"
                        CornerRadius="{StaticResource Radius.Md}"
                        ClipToBounds="True">
                    <Grid ColumnDefinitions="5,*">
                        <controls:ContinuousBorder Grid.Column="0"
                                Background="Transparent"/>

                        <Grid Grid.Column="1"
                              Margin="13,12,13,12"
                              RowDefinitions="Auto,Auto,Auto"
                              RowSpacing="7">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="当前 Photoshop 文档"
                                           Classes="micro"
                                           Foreground="{StaticResource Brush.TextSecondary}"
                                           FontWeight="SemiBold"
                                           LetterSpacing="0"
                                           VerticalAlignment="Center"/>
                                <Ellipse x:Name="PsStatusDot"
                                         Grid.Column="2"
                                         Width="8"
                                         Height="8"
                                         Fill="{Binding IsPsRunning, Converter={x:Static vm:BoolToStatusBrushConverter.Instance}}"
                                         RenderTransformOrigin="50%,50%"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Grid.Row="1"
                                       Text="{Binding DocumentDisplayName}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.TextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>

                            <Grid Grid.Row="2"
                                  ColumnDefinitions="*,1,*,1,*"
                                  ColumnSpacing="12"
                                  HorizontalAlignment="Stretch">
                                <StackPanel Grid.Column="0"
                                            Spacing="1"
                                            HorizontalAlignment="Stretch">
                                    <TextBlock Text="PS 版本"
                                               Classes="micro"
                                               Foreground="{StaticResource Brush.TextMuted}"
                                               HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding PsVersionDisplay}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.TextSecondary}"
                                               TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Left"/>
                                </StackPanel>

                                <controls:ContinuousBorder Grid.Column="1"
                                        Width="1"
                                        Height="36"
                                        Background="{StaticResource Brush.Divider}"
                                        VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="2"
                                            Spacing="1"
                                            HorizontalAlignment="Stretch">
                                    <TextBlock Text="画布尺寸"
                                               Classes="micro"
                                               Foreground="{StaticResource Brush.TextMuted}"
                                               HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding DocumentSizeDisplay}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.TextSecondary}"
                                               TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Left"/>
                                </StackPanel>

                                <controls:ContinuousBorder Grid.Column="3"
                                        Width="1"
                                        Height="36"
                                        Background="{StaticResource Brush.Divider}"
                                        VerticalAlignment="Center"/>

                                <controls:ContinuousBorder Grid.Column="4"
                                        Background="{StaticResource Brush.Accent}"
                                        CornerRadius="{StaticResource Radius.Sm}"
                                        Padding="9,5"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center">
                                    <StackPanel Spacing="0">
                                        <TextBlock Text="当前模式"
                                                   Classes="micro"
                                                   Foreground="#DDE0FF"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding CurrentModeTitle}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFFFFF"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </controls:ContinuousBorder>
                            </Grid>
                        </Grid>
                    </Grid>
                </controls:ContinuousBorder>

                <!-- 2. Mode Selector: content-sized segments with consistent gaps -->
                <controls:AnimatedSegmentTrack Grid.Row="2"
                        Margin="16,6,16,6"
                        IsVisible="{Binding !IsViewSetting}" Classes="choice-track" SelectionValue="{Binding SelectedMode}">
                    <controls:SegmentPanel>
                        <Button
                                Classes="mode"
                                Command="{Binding SelectModeCommand}"
                                CommandParameter="{x:Static models:ExportMode.QuickExport}"
                                IsEnabled="{Binding CanChangeMode}">
                            <controls:ContinuousBorder Classes="mode-fill"
                                    Background="Transparent"
                                    CornerRadius="{StaticResource Radius.SegmentInner}" BorderBrush="Transparent" BorderThickness="0">
                                <TextBlock Text="快速导出"
                                           Classes="mode-label"
                                           Foreground="{Binding SelectedMode, Converter={x:Static vm:ExportModeIconColorConverter.Instance}, ConverterParameter={x:Static models:ExportMode.QuickExport}}"/>
                            </controls:ContinuousBorder>
                        </Button>

                        <Button
                                Classes="mode"
                                Command="{Binding SelectModeCommand}"
                                CommandParameter="{x:Static models:ExportMode.AllArtboards}"
                                controls:AnimatedSegmentTrack.SelectionAlias="{x:Static models:ExportMode.SelectedArtboards}"
                                IsEnabled="{Binding CanChangeMode}">
                            <controls:ContinuousBorder Classes="mode-fill"
                                    Background="Transparent"
                                    CornerRadius="{StaticResource Radius.SegmentInner}" BorderBrush="Transparent" BorderThickness="0">
                                <TextBlock Text="画板导出"
                                           Classes="mode-label"
                                           Foreground="{Binding IsArtboardMode, Converter={x:Static vm:BoolToIconColorConverter.Instance}}"/>
                            </controls:ContinuousBorder>
                        </Button>

                        <Button
                                Classes="mode"
                                Command="{Binding SelectModeCommand}"
                                CommandParameter="{x:Static models:ExportMode.Layers}"
                                IsEnabled="{Binding CanChangeMode}">
                            <controls:ContinuousBorder Classes="mode-fill"
                                    Background="Transparent"
                                    CornerRadius="{StaticResource Radius.SegmentInner}" BorderBrush="Transparent" BorderThickness="0">
                                <TextBlock Text="图层导出"
                                           Classes="mode-label"
                                           Foreground="{Binding SelectedMode, Converter={x:Static vm:ExportModeIconColorConverter.Instance}, ConverterParameter={x:Static models:ExportMode.Layers}}"/>
                            </controls:ContinuousBorder>
                        </Button>

                        <Button
                                Classes="mode"
                                Command="{Binding SelectModeCommand}"
                                CommandParameter="{x:Static models:ExportMode.Slices}"
                                IsEnabled="{Binding CanChangeMode}">
                            <controls:ContinuousBorder Classes="mode-fill"
                                    Background="Transparent"
                                    CornerRadius="{StaticResource Radius.SegmentInner}" BorderBrush="Transparent" BorderThickness="0">
                                <TextBlock Text="切片导出"
                                           Classes="mode-label"
                                           Foreground="{Binding SelectedMode, Converter={x:Static vm:ExportModeIconColorConverter.Instance}, ConverterParameter={x:Static models:ExportMode.Slices}}"/>
                            </controls:ContinuousBorder>
                        </Button>
                    </controls:SegmentPanel>
                </controls:AnimatedSegmentTrack>

                <!-- 参数与任务状态按内容排布，共用一个受窗口约束的滚动区。 -->
                <Grid Grid.Row="3">
                    <ScrollViewer x:Name="ExportScrollViewer" Classes="subtle-scroll"
                        IsVisible="{Binding !IsViewSetting}" AllowAutoHide="False"
                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ExportContentHost">
                            <StackPanel.Margin>
                                <MultiBinding Converter="{x:Static vm:ScrollContentInsetConverter.Instance}" ConverterParameter="{StaticResource Space.Lg}">
                                    <Binding ElementName="ExportScrollViewer" Path="Bounds.Width"/>
                                    <Binding ElementName="ExportScrollViewer" Path="Viewport.Width"/>
                                </MultiBinding>
                            </StackPanel.Margin>
                            <views:ExportPresetBar x:Name="ExportPresets" Margin="0,6,0,6"/>
                            <controls:ContinuousBorder Margin="0,6,0,12"
                                Background="{StaticResource Brush.Surface}"
                                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Md}" Padding="{StaticResource Padding.Panel}">
                                <!-- Export Panel -->
                                <Grid RowDefinitions="Auto,Auto"
                                      RowSpacing="{StaticResource Space.Md}">

                                    <controls:ContinuousBorder Grid.Row="0" Classes="workspace-heading">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <StackPanel Grid.Column="0"
                                                        Orientation="Horizontal"
                                                        Spacing="8"
                                                        VerticalAlignment="Center">
                                                <controls:ContinuousBorder Width="4"
                                                        Height="22"
                                                        Background="{StaticResource Brush.Accent}"
                                                        CornerRadius="2"/>
                                                <TextBlock Text="{Binding CurrentModeTitle}"
                                                           Classes="title"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        Classes="output-meta" Orientation="Horizontal" Height="{StaticResource Control.BadgeHeight}"
                                                        Spacing="6"
                                                        VerticalAlignment="Center">
                                                <Button Classes="compact-action" Classes.active="{Binding AutoRename}"
                                                    Command="{Binding ToggleAutoRenameCommand}" ToolTip.Tip="{Binding AutoRenameHint}"
                                                    AutomationProperties.Name="同名自动改名" AutomationProperties.HelpText="{Binding AutoRenameHint}">
                                                    <TextBlock Text="自动改名" VerticalAlignment="Center"/>
                                                </Button>
                                                <controls:ContinuousBorder Background="{StaticResource Brush.Surface}"
                                                        BorderBrush="{StaticResource Brush.Border}"
                                                        BorderThickness="1"
                                                        IsVisible="{Binding IsJpgFormat}" Classes="meta-badge">
                                                    <TextBlock Text="JPG"
                                                               Classes="micro meta-label"
                                                               Foreground="{StaticResource Brush.TextSecondary}"
                                                               FontWeight="SemiBold"/>
                                                </controls:ContinuousBorder>
                                                <controls:ContinuousBorder Background="{StaticResource Brush.Surface}"
                                                        BorderBrush="{StaticResource Brush.Border}"
                                                        BorderThickness="1"
                                                        IsVisible="{Binding !IsJpgFormat}" Classes="meta-badge">
                                                    <TextBlock Text="PNG"
                                                               Classes="micro meta-label"
                                                               Foreground="{StaticResource Brush.TextSecondary}"
                                                               FontWeight="SemiBold"/>
                                                </controls:ContinuousBorder>
                                                <controls:ContinuousBorder Background="{StaticResource Brush.StatusSurface}"
                                                        BorderBrush="{StaticResource Brush.StatusBorder}"
                                                        BorderThickness="1"
                                                        IsVisible="{Binding IsJpgFormat}" Classes="meta-badge">
                                                    <TextBlock Classes="micro meta-label"
                                                               Foreground="{StaticResource Brush.StatusText}"
                                                               FontWeight="SemiBold">
                                                        <Run Text="{Binding Quality}"/>
                                                        <Run Text="%"/>
                                                    </TextBlock>
                                                </controls:ContinuousBorder>
                                            </StackPanel>
                                        </Grid>
                                    </controls:ContinuousBorder>

                                        <StackPanel Grid.Row="1" Margin="0,6,0,8" Spacing="20">
                                            <!-- Export target comes first; hidden rows reserve no space. -->
                                            <controls:SegmentOptionRow
                                                  Spacing="12"
                                                  VerticalAlignment="Center"
                                                  IsVisible="{Binding IsArtboardMode}">
                                                <TextBlock Text="导出范围" Classes="label"/>
                                                <controls:AnimatedSegmentTrack Classes="choice-track" SelectionValue="{Binding SelectedMode}">
                                                    <controls:SegmentPanel>
                                                        <Button
                                                                Classes="seg"
                                                                Command="{Binding SelectModeCommand}"
                                                                CommandParameter="{x:Static models:ExportMode.AllArtboards}">
                                                            <controls:ContinuousBorder Background="Transparent"
                                                                    CornerRadius="{StaticResource Radius.SegmentInner}" BorderBrush="Transparent" BorderThickness="0">
                                                                <TextBlock Text="全部画板"
                                                                           Classes="mode-label"
                                                                           Foreground="{Binding SelectedMode, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter={x:Static models:ExportMode.AllArtboards}}"/>
                                                            </controls:ContinuousBorder>
                                                        </Button>
                                                        <Button
                                                                Classes="seg"
                                                                Command="{Binding SelectModeCommand}"
                                                                CommandParameter="{x:Static models:ExportMode.SelectedArtboards}"
                                                                ToolTip.Tip="导出 Photoshop 中当前选中的画板">
                                                            <controls:ContinuousBorder Background="Transparent"
                                                                    CornerRadius="{StaticResource Radius.SegmentInner}" BorderBrush="Transparent" BorderThickness="0">
                                                                <TextBlock Text="当前选中"
                                                                           Classes="mode-label"
                                                                           Foreground="{Binding SelectedMode, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter={x:Static models:ExportMode.SelectedArtboards}}"/>
                                                            </controls:ContinuousBorder>
                                                        </Button>
                                                    </controls:SegmentPanel>
                                                </controls:AnimatedSegmentTrack>
                                            </controls:SegmentOptionRow>

                                            <StackPanel IsVisible="{Binding IsLayerMode}" Spacing="8">
                                                <controls:SegmentOptionRow Spacing="12">
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="导出方式" Classes="label" VerticalAlignment="Center"/>
                                                        <Button Classes="tool" Width="24" Height="24" MinWidth="24" MinHeight="24" Padding="0"
                                                            ToolTip.Tip="{Binding LayerModeHelpText}" AutomationProperties.Name="图层导出说明"
                                                            AutomationProperties.HelpText="悬停或点击查看画布合成、图层素材与排除规则">
                                                            <Viewbox Width="14" Height="14">
                                                                <Canvas Width="16" Height="16">
                                                                    <Path Data="M8,1 A7,7 0 1 1 8,15 A7,7 0 1 1 8,1 M6,6 A2,2 0 1 1 9,7.7 L8,8.5 L8,10"
                                                                        Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.25"/>
                                                                    <Ellipse Width="1.4" Height="1.4" Canvas.Left="7.3" Canvas.Top="11.3" Fill="{Binding $parent[Button].Foreground}"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                            <Button.Flyout>
                                                                <Flyout ShowMode="Standard" OverlayDismissEventPassThrough="False" Placement="BottomEdgeAlignedLeft"
                                                                    FlyoutPresenterTheme="{StaticResource LayerHelpFlyoutTheme}">
                                                                    <StackPanel Spacing="8" MaxWidth="276">
                                                                        <TextBlock Text="图层导出说明" FontWeight="SemiBold"/>
                                                                        <TextBlock Text="{Binding LayerModeHelpText}" FontSize="12" TextWrapping="Wrap"/>
                                                                    </StackPanel>
                                                                </Flyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                    </StackPanel>
                                                    <controls:AnimatedSegmentTrack Classes="choice-track" SelectionValue="{Binding LayerExportRecursive}" IsEnabled="{Binding !IsExporting}">
                                                        <controls:SegmentPanel>
                                                            <Button Classes="seg" Command="{Binding SetLayerExportRecursiveCommand}" CommandParameter="False" ToolTip.Tip="保留画布尺寸，最外层图层/组与公共背景、水印分别合成。"><controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}"><TextBlock Text="画布合成" Classes="mode-label" Foreground="{Binding LayerExportRecursive, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=False}"/></controls:ContinuousBorder></Button>
                                                            <Button Classes="seg" Command="{Binding SetLayerExportRecursiveCommand}" CommandParameter="True" ToolTip.Tip="按图层或图层组自身边界导出素材。"><controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}"><TextBlock Text="图层素材" Classes="mode-label" Foreground="{Binding LayerExportRecursive, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=True}"/></controls:ContinuousBorder></Button>
                                                        </controls:SegmentPanel>
                                                    </controls:AnimatedSegmentTrack>
                                                </controls:SegmentOptionRow>
                                                <controls:SegmentOptionRow Spacing="12" IsVisible="{Binding ShowLayerSelection}">
                                                    <TextBlock Text="导出范围" Classes="label"/>
                                                    <controls:AnimatedSegmentTrack Classes="choice-track" SelectionValue="{Binding IsLayerSelectionSelectedOnly}" IsEnabled="{Binding !IsExporting}">
                                                        <controls:SegmentPanel>
                                                            <Button Classes="seg" Command="{Binding SetLayerExportSelectedOnlyCommand}" CommandParameter="True"><controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}"><TextBlock Text="选中" Classes="mode-label" Foreground="{Binding IsLayerSelectionSelectedOnly, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=True}"/></controls:ContinuousBorder></Button>
                                                            <Button Classes="seg" Command="{Binding SetLayerExportSelectedOnlyCommand}" CommandParameter="False"><controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}"><TextBlock Text="全部" Classes="mode-label" Foreground="{Binding IsLayerSelectionSelectedOnly, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=False}"/></controls:ContinuousBorder></Button>
                                                        </controls:SegmentPanel>
                                                    </controls:AnimatedSegmentTrack>
                                                </controls:SegmentOptionRow>
                                            </StackPanel>

                                            <!-- Image specification: format and its dependent quality control. -->
                                            <StackPanel Spacing="12">
                                                <!-- Image format; JPG quality stays immediately below. -->
                                                <controls:SegmentOptionRow Spacing="12" VerticalAlignment="Center">
                                                    <TextBlock Text="图片格式" Classes="label"/>
                                                    <controls:AnimatedSegmentTrack Classes="choice-track" SelectionValue="{Binding Format}">
                                                        <controls:SegmentPanel>
                                                            <Button
                                                                    Classes="seg"
                                                                    Command="{Binding SetFormatCommand}"
                                                                    CommandParameter="{x:Static models:ExportFormat.Jpg}">
                                                                <controls:ContinuousBorder Background="Transparent"
                                                                        CornerRadius="{StaticResource Radius.SegmentInner}" BorderBrush="Transparent" BorderThickness="0">
                                                                    <TextBlock Text="JPG 格式"
                                                                               Classes="mode-label"
                                                                               Foreground="{Binding Format, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter={x:Static models:ExportFormat.Jpg}}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>
                                                            <Button
                                                                    Classes="seg"
                                                                    Command="{Binding SetFormatCommand}"
                                                                    CommandParameter="{x:Static models:ExportFormat.Png}">
                                                                <controls:ContinuousBorder Background="Transparent"
                                                                        CornerRadius="{StaticResource Radius.SegmentInner}" BorderBrush="Transparent" BorderThickness="0">
                                                                    <TextBlock Text="PNG 无损"
                                                                               Classes="mode-label"
                                                                               Foreground="{Binding Format, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter={x:Static models:ExportFormat.Png}}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>
                                                        </controls:SegmentPanel>
                                                    </controls:AnimatedSegmentTrack>
                                                </controls:SegmentOptionRow>

                                                <!-- JPG-only quality: one field, one surface. -->
                                                <Grid x:Name="QualityControl" Cursor="Arrow" ColumnDefinitions="76,*" ColumnSpacing="12" VerticalAlignment="Center" IsVisible="{Binding IsJpgFormat}">
                                                    <TextBlock Text="图片质量" Classes="label"/>
                                                    <Grid Grid.Column="1" ColumnDefinitions="*,64" ColumnSpacing="12">
                                                        <Grid x:Name="QualityMeter"
                                                                  Cursor="Arrow"
                                                                  Grid.Column="0"
                                                                  ColumnDefinitions="*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*"
                                                                  ColumnSpacing="1.5"
                                                                  Height="{StaticResource Control.StandardHeight}"
                                                                  VerticalAlignment="Center"
                                                                  Background="Transparent"
                                                                  ClipToBounds="False">
<Button Grid.Column="0" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="4" ToolTip.Tip="4%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=4}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="1" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="8" ToolTip.Tip="8%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=8}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="2" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="12" ToolTip.Tip="12%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=12}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="3" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="16" ToolTip.Tip="16%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=16}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="4" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="20" ToolTip.Tip="20%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=20}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="5" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="24" ToolTip.Tip="24%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=24}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="6" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="28" ToolTip.Tip="28%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=28}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="7" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="32" ToolTip.Tip="32%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=32}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="8" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="36" ToolTip.Tip="36%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=36}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="9" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="40" ToolTip.Tip="40%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=40}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="10" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="44" ToolTip.Tip="44%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=44}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="11" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="48" ToolTip.Tip="48%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=48}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="12" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="52" ToolTip.Tip="52%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=52}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="13" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="56" ToolTip.Tip="56%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=56}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="14" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="60" ToolTip.Tip="60%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=60}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="15" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="64" ToolTip.Tip="64%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=64}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="16" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="68" ToolTip.Tip="68%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=68}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="17" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="72" ToolTip.Tip="72%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=72}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="18" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="76" ToolTip.Tip="76%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=76}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="19" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="80" ToolTip.Tip="80%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=80}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="20" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="84" ToolTip.Tip="84%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=84}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="21" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="88" ToolTip.Tip="88%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=88}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="22" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="92" ToolTip.Tip="92%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=92}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="23" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="96" ToolTip.Tip="96%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=96}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="24" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="100" ToolTip.Tip="100%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=100}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
                                                            </Grid>
                                                        <controls:ContinuousBorder Grid.Column="1" Classes="input-shell" Height="{StaticResource Control.InputHeight}" CornerRadius="{StaticResource Radius.Sm}"
                                                            Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBox x:Name="QualityInput" Text="{Binding Quality}" Height="{StaticResource Control.InputInnerHeight}" MinWidth="0" Padding="6,0,0,0"
                                                                    Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Text="%" Margin="0,0,8,0" Classes="hint" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </controls:ContinuousBorder>
                                                    </Grid>
                                                </Grid>
                                            </StackPanel>

                                            <!-- Saving: destination, optional folder, then file name or prefix. -->
                                            <StackPanel Spacing="12">
                                                <!-- Output destination is shared by every export mode. -->
                                                <StackPanel Spacing="8" IsEnabled="{Binding CanChangeMode}">
                                                    <controls:SegmentOptionRow Spacing="12">
                                                        <TextBlock Text="输出位置" Classes="label" VerticalAlignment="Center"/>
                                                        <controls:AnimatedSegmentTrack Classes="choice-track" SelectionValue="{Binding Destination}">
                                                            <controls:SegmentPanel>
                                                                <Button Classes="seg" Command="{Binding SetDestinationCommand}"
                                                                    CommandParameter="{x:Static models:ExportDestination.DocumentFolder}" ToolTip.Tip="导出到当前 Photoshop 文档所在的文件夹；文档需先保存。">
                                                                    <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                        <TextBlock Text="文档位置" Classes="mode-label"
                                                                        Foreground="{Binding Destination, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter={x:Static models:ExportDestination.DocumentFolder}}"/>
                                                                    </controls:ContinuousBorder>
                                                                </Button>
                                                                <Button Classes="seg" Command="{Binding SetDestinationCommand}"
                                                                    CommandParameter="{x:Static models:ExportDestination.Desktop}" ToolTip.Tip="使用 Windows 的实际桌面目录，兼容桌面重定向。">
                                                                    <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                        <TextBlock Text="桌面" Classes="mode-label"
                                                                        Foreground="{Binding Destination, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter={x:Static models:ExportDestination.Desktop}}"/>
                                                                    </controls:ContinuousBorder>
                                                                </Button>
                                                                <Button Classes="seg" Command="{Binding SetDestinationCommand}"
                                                                    CommandParameter="{x:Static models:ExportDestination.Custom}" ToolTip.Tip="输入或选择目录；切换预设会保留之前填写的路径。">
                                                                    <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                        <TextBlock Text="自定义" Classes="mode-label"
                                                                        Foreground="{Binding Destination, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter={x:Static models:ExportDestination.Custom}}"/>
                                                                    </controls:ContinuousBorder>
                                                                </Button>
                                                            </controls:SegmentPanel>
                                                        </controls:AnimatedSegmentTrack>
                                                    </controls:SegmentOptionRow>
                                                    <!-- Both path layouts span the card content, independent of the label/segment row. -->
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" HorizontalAlignment="Stretch" IsVisible="{Binding IsCustomDestination}">
                                                        <controls:ContinuousBorder Classes="input-shell" Height="{StaticResource Control.InputHeight}"
                                                            CornerRadius="{StaticResource Radius.Sm}" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                                                            <TextBox Background="Transparent" BorderThickness="0" Text="{Binding ExportPath, Mode=TwoWay}"
                                                                ToolTip.Tip="{Binding ExportPath}"
                                                                PlaceholderText="输入或选择文件夹" AutomationProperties.Name="自定义输出路径"
                                                                VerticalContentAlignment="Center" Padding="10,0"/>
                                                        </controls:ContinuousBorder>
                                                        <Button Grid.Column="1" Classes="folder" Command="{Binding BrowseExportFolderCommand}"
                                                            ToolTip.Tip="选择输出文件夹" AutomationProperties.Name="选择输出文件夹">
                                                            <TextBlock Text="{StaticResource Icon.Folder}" Classes="icon"/>
                                                        </Button>
                                                    </Grid>
                                                    <controls:ContinuousBorder Classes="input-shell" Height="{StaticResource Control.InputHeight}"
                                                        HorizontalAlignment="Stretch" IsVisible="{Binding IsPresetDestination}"
                                                        CornerRadius="{StaticResource Radius.Sm}" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                                                        <TextBox Background="Transparent" BorderThickness="0" Text="{Binding ResolvedExportPath, Mode=OneWay}"
                                                            IsReadOnly="True" PlaceholderText="等待获取输出位置" AutomationProperties.Name="输出路径（只读）"
                                                            ToolTip.Tip="{Binding ResolvedExportPath}"
                                                            VerticalContentAlignment="Center" Padding="10,0"/>
                                                    </controls:ContinuousBorder>
                                                    <TextBlock Text="{Binding DestinationHint}" IsVisible="{Binding !HasExportTarget}"
                                                        Classes="setting-description" TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <!-- Artboard folder strategy belongs with the output destination. -->
                                                <controls:SegmentOptionRow
                                                      Spacing="12"
                                                      VerticalAlignment="Center"
                                                      IsVisible="{Binding IsArtboardMode}">
                                                    <TextBlock Text="存放方式" Classes="label" ToolTip.Tip="在上方输出目录内，选择直接保存画板图片或按文档名建文件夹。"/>
                                                    <controls:AnimatedSegmentTrack Classes="choice-track" SelectionValue="{Binding ExportPathOption}">
                                                        <controls:SegmentPanel>
                                                            <Button
                                                                    Classes="seg"
                                                                    Command="{Binding SetExportPathOptionCommand}"
                                                                    CommandParameter="{x:Static models:ExportPathOption.ImageOnly}"
                                                                    ToolTip.Tip="直接将画板图片保存到当前选择的输出目录">
                                                                <controls:ContinuousBorder Background="Transparent"
                                                                        CornerRadius="{StaticResource Radius.SegmentInner}" BorderBrush="Transparent" BorderThickness="0">
                                                                    <TextBlock Text="图片直出"
                                                                               Classes="mode-label"
                                                                               FontSize="11"
                                                                               Foreground="{Binding ExportPathOption, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter={x:Static models:ExportPathOption.ImageOnly}}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>

                                                            <Button
                                                                    Classes="seg"
                                                                    Command="{Binding SetExportPathOptionCommand}"
                                                                    CommandParameter="{x:Static models:ExportPathOption.NewFolder}"
                                                                    ToolTip.Tip="按当前 Photoshop 文档名新建文件夹；重名时自动追加序号，保留旧结果">
                                                                <controls:ContinuousBorder Background="Transparent"
                                                                        CornerRadius="{StaticResource Radius.SegmentInner}" BorderBrush="Transparent" BorderThickness="0">
                                                                    <TextBlock Text="文档文件夹"
                                                                               Classes="mode-label"
                                                                               FontSize="11"
                                                                               Foreground="{Binding ExportPathOption, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter={x:Static models:ExportPathOption.NewFolder}}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>

                                                            <Button
                                                                    Classes="seg"
                                                                    Command="{Binding SetExportPathOptionCommand}"
                                                                    CommandParameter="{x:Static models:ExportPathOption.NewFolderOverwrite}"
                                                                    ToolTip.Tip="使用当前 Photoshop 文档名文件夹；已存在时复用，并更新本次同名导出文件">
                                                                <controls:ContinuousBorder Background="Transparent"
                                                                        CornerRadius="{StaticResource Radius.SegmentInner}" BorderBrush="Transparent" BorderThickness="0">
                                                                    <TextBlock Text="覆盖文件夹"
                                                                               Classes="mode-label"
                                                                               FontSize="11"
                                                                               Foreground="{Binding ExportPathOption, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter={x:Static models:ExportPathOption.NewFolderOverwrite}}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>
                                                        </controls:SegmentPanel>
                                                    </controls:AnimatedSegmentTrack>
                                                </controls:SegmentOptionRow>

                                                <!-- Optional slice subfolder; shares the existing parameter grid and input style. -->
                                                <Grid ColumnDefinitions="76,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" VerticalAlignment="Center"
                                                      IsVisible="{Binding IsFileNameVisible}">
                                                    <TextBlock Text="切片文件夹" Classes="label"
                                                               ToolTip.Tip="填写后在输出位置内创建或复用同名子文件夹；留空直接导出。"/>
                                                    <controls:ContinuousBorder Grid.Column="1" Classes="input-shell"
                                                        Height="{StaticResource Control.InputHeight}" CornerRadius="{StaticResource Radius.Sm}"
                                                        Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                                                        <TextBox Background="Transparent" BorderThickness="0" Text="{Binding SliceFolderName}"
                                                            PlaceholderText="留空不建文件夹" AutomationProperties.Name="切片文件夹名称（可选）"
                                                            VerticalContentAlignment="Center" Padding="10,0"/>
                                                    </controls:ContinuousBorder>
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Text="{Binding SliceFolderNameError}"
                                                        IsVisible="{Binding HasSliceFolderNameError}" TextWrapping="Wrap" FontSize="12"
                                                        Foreground="{StaticResource Brush.Error}"/>
                                                </Grid>

                                                <!-- Shared full name for quick export; literal optional prefix for all batch modes. -->
                                                <Grid ColumnDefinitions="76,*"
                                                      ColumnSpacing="12"
                                                      VerticalAlignment="Center"
                                                      IsVisible="{Binding IsImageNameVisible}">
                                                    <TextBlock Grid.Column="0" Text="{Binding ImageNameLabel}" Classes="label"/>
                                                    <controls:ContinuousBorder Grid.Column="1"  Classes="input-shell" Height="{StaticResource Control.InputHeight}" CornerRadius="{StaticResource Radius.Sm}" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"><TextBox Background="Transparent" BorderThickness="0"
                                                             Text="{Binding ImageName}" ToolTip.Tip="{Binding ImageNameHint}" AutomationProperties.Name="{Binding ImageNameLabel}"
                                                             PlaceholderText="{Binding ImageNamePlaceholder}"
                                                             VerticalContentAlignment="Center"
                                                             Padding="10,0"/></controls:ContinuousBorder>
                                                </Grid>
                                            </StackPanel>

                                        </StackPanel>


                                </Grid>
                            </controls:ContinuousBorder>
                            <controls:ContinuousBorder Margin="0,0,0,8" Padding="12,10"
                                IsVisible="{Binding !IsViewSetting}" CornerRadius="{StaticResource Radius.Md}"
                                Background="{StaticResource Brush.StatusSurface}" BorderBrush="{StaticResource Brush.StatusBorder}" BorderThickness="1">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="任务状态" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Classes="hint" Text="{Binding ExportedCount, StringFormat='已生成 {0} 个文件'}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding ExportStatusText}" ToolTip.Tip="{Binding ExportStatusText}" TextWrapping="Wrap" FontSize="12"/>
                                    <controls:ContinuousBorder CornerRadius="2" IsVisible="{Binding IsExporting}"><ProgressBar CornerRadius="0" IsIndeterminate="True"/></controls:ContinuousBorder>
                                </StackPanel>
                            </controls:ContinuousBorder>
                        </StackPanel>
                    </ScrollViewer>
                    <!-- 五组分节清单：组标签在卡外，卡片只承载行；图标全部去掉，层级靠字号与字色。 -->
                    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12"
                          Margin="0,6,0,12" IsVisible="{Binding IsViewSetting}">
                        <TextBlock Grid.Row="0" Text="设置" Classes="title"
                            Margin="16,0"/>
                        <controls:ContinuousBorder Grid.Row="1" Classes="input-shell settings-search"
                            Margin="16,0" Height="36" Padding="10,0"
                            Background="{DynamicResource Brush.SettingsCard}"
                            BorderThickness="1" CornerRadius="{StaticResource Radius.Sm}">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                <Path Data="M6.5 1A5.5 5.5 0 1 0 6.5 12A5.5 5.5 0 1 0 6.5 1 M10.5 10.5L15 15"
                                    Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1.4" VerticalAlignment="Center"/>
                                <TextBox x:Name="SettingsSearchInput" Classes="settings-search-input" Grid.Column="1" Text="{Binding SettingsSearchQuery, Mode=TwoWay}"
                                    PlaceholderText="搜索设置…" AutomationProperties.Name="搜索设置" ToolTip.Tip="搜索名称或用途，例如主题、托盘、更新"
                                    Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding SettingsSearchSummary}" IsVisible="{Binding IsSearchingSettings}"
                                    FontSize="{StaticResource FontSize.Caption}" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                                <Button Grid.Column="3" Classes="tool" Width="24" Height="24" MinHeight="24" MaxHeight="24" Padding="0" VerticalAlignment="Center"
                                    IsVisible="{Binding HasSettingsSearchText}" Command="{Binding ClearSettingsSearchCommand}" Click="OnClearSettingsSearchClick"
                                    ToolTip.Tip="清空搜索" AutomationProperties.Name="清空设置搜索">
                                    <Path Data="M1 1L11 11 M11 1L1 11" Width="10" Height="10" Stretch="Uniform"
                                        Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.4"/>
                                </Button>
                            </Grid>
                        </controls:ContinuousBorder>
                        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="2" Classes="subtle-scroll" AllowAutoHide="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="SettingsPageHost" Classes="settings-page">
                                <StackPanel.Margin>
                                    <MultiBinding Converter="{x:Static vm:ScrollContentInsetConverter.Instance}" ConverterParameter="{StaticResource Space.Lg}">
                                        <Binding ElementName="SettingsScrollViewer" Path="Bounds.Width"/>
                                        <Binding ElementName="SettingsScrollViewer" Path="Viewport.Width"/>
                                    </MultiBinding>
                                </StackPanel.Margin>
                                <StackPanel Spacing="{StaticResource Space.Sm}" IsVisible="{Binding ShowUiWindowCard}">
                                    <TextBlock Classes="settings-group-label" Text="外观与窗口"/>
                                    <controls:ContinuousBorder Classes="settings-section">
                                        <StackPanel>
                                            <Grid Classes="settings-row" IsVisible="{Binding ShowThemeSetting}" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <TextBlock Text="主题" Classes="setting-label" VerticalAlignment="Center"/>
                                                <controls:AnimatedSegmentTrack Grid.Column="1" Classes="choice-track" VerticalAlignment="Center" SelectionValue="{Binding ThemeMode}">
                                                    <controls:SegmentPanel>
                                                        <Button Classes="seg" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static models:AppThemeMode.System}">
                                                            <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                <TextBlock Text="跟随系统" ToolTip.Tip="跟随系统主题" Classes="mode-label" Foreground="{Binding ThemeMode, Converter={x:Static vm:EqualsToTextBrushConverter.SettingsInstance}, ConverterParameter={x:Static models:AppThemeMode.System}}"/>
                                                            </controls:ContinuousBorder>
                                                        </Button>
                                                        <Button Classes="seg" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static models:AppThemeMode.Light}">
                                                            <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                <TextBlock Text="浅色" Classes="mode-label" Foreground="{Binding ThemeMode, Converter={x:Static vm:EqualsToTextBrushConverter.SettingsInstance}, ConverterParameter={x:Static models:AppThemeMode.Light}}"/>
                                                            </controls:ContinuousBorder>
                                                        </Button>
                                                        <Button Classes="seg" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static models:AppThemeMode.Dark}">
                                                            <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                <TextBlock Text="深色" Classes="mode-label" Foreground="{Binding ThemeMode, Converter={x:Static vm:EqualsToTextBrushConverter.SettingsInstance}, ConverterParameter={x:Static models:AppThemeMode.Dark}}"/>
                                                            </controls:ContinuousBorder>
                                                        </Button>
                                                    </controls:SegmentPanel>
                                                </controls:AnimatedSegmentTrack>
                                            </Grid>
                                            <controls:ContinuousBorder Classes="settings-separator" IsVisible="{Binding ShowThemeTrayLine}"/>
                                            <Grid Classes="settings-row" IsVisible="{Binding ShowTraySetting}" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <TextBlock Text="关闭后常驻后台" Classes="setting-label" VerticalAlignment="Center" ToolTip.Tip="关闭按钮收起到托盘；在托盘右键菜单中选择退出。"/>
                                                <Panel Grid.Column="1">
                                                    <controls:AnimatedSegmentTrack Classes="choice-track" SelectionValue="{Binding CloseToTray}">
                                                        <controls:SegmentPanel>
                                                            <Button Classes="seg" Command="{Binding SetCloseToTrayCommand}" CommandParameter="False" AutomationProperties.Name="关闭后常驻后台：关闭">
                                                                <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                    <TextBlock Text="关闭" Classes="mode-label" Foreground="{Binding CloseToTray, Converter={x:Static vm:EqualsToTextBrushConverter.SettingsInstance}, ConverterParameter=False}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>
                                                            <Button Classes="seg" Command="{Binding SetCloseToTrayCommand}" CommandParameter="True" AutomationProperties.Name="关闭后常驻后台：开启">
                                                                <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                    <TextBlock Text="开启" Classes="mode-label" Foreground="{Binding CloseToTray, Converter={x:Static vm:EqualsToTextBrushConverter.SettingsInstance}, ConverterParameter=True}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>
                                                        </controls:SegmentPanel>
                                                    </controls:AnimatedSegmentTrack>
                                                </Panel>
                                            </Grid>
                                            <controls:ContinuousBorder Classes="settings-separator" IsVisible="{Binding ShowTrayEdgeLine}"/>
                                            <Grid Classes="settings-row" IsVisible="{Binding ShowEdgeSetting}" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <TextBlock Text="贴边收纳" Classes="setting-label" VerticalAlignment="Center" ToolTip.Tip="拖到屏幕边缘后收纳，悬停或点击入口展开。"/>
                                                <Panel Grid.Column="1">
                                                    <controls:AnimatedSegmentTrack Classes="choice-track" SelectionValue="{Binding EnableEdgeSnap}">
                                                        <controls:SegmentPanel>
                                                            <Button Classes="seg" Command="{Binding SetEnableEdgeSnapCommand}" CommandParameter="False" AutomationProperties.Name="贴边收纳：关闭">
                                                                <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                    <TextBlock Text="关闭" Classes="mode-label" Foreground="{Binding EnableEdgeSnap, Converter={x:Static vm:EqualsToTextBrushConverter.SettingsInstance}, ConverterParameter=False}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>
                                                            <Button Classes="seg" Command="{Binding SetEnableEdgeSnapCommand}" CommandParameter="True" AutomationProperties.Name="贴边收纳：开启">
                                                                <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                    <TextBlock Text="开启" Classes="mode-label" Foreground="{Binding EnableEdgeSnap, Converter={x:Static vm:EqualsToTextBrushConverter.SettingsInstance}, ConverterParameter=True}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>
                                                        </controls:SegmentPanel>
                                                    </controls:AnimatedSegmentTrack>
                                                </Panel>
                                            </Grid>
                                            <controls:ContinuousBorder Classes="settings-separator" IsVisible="{Binding ShowEdgeDelayLine}"/>
                                            <Grid Classes="settings-row" IsVisible="{Binding ShowDelaySetting}" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <TextBlock Text="收回等待" Classes="setting-label" VerticalAlignment="Center" ToolTip.Tip="鼠标移出后等待 250 / 420 / 800 毫秒再收回。"/>
                                                <controls:AnimatedSegmentTrack Grid.Column="1" Classes="choice-track" VerticalAlignment="Center" SelectionValue="{Binding DockRetractDelayMs}" IsEnabled="{Binding EnableEdgeSnap}">
                                                    <controls:SegmentPanel>
                                                        <Button Classes="seg" Command="{Binding SetDockRetractDelayCommand}" CommandParameter="250">
                                                            <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                <TextBlock Text="快速" Classes="mode-label" Foreground="{Binding DockRetractDelayMs, Converter={x:Static vm:EqualsToTextBrushConverter.SettingsInstance}, ConverterParameter=250}"/>
                                                            </controls:ContinuousBorder>
                                                        </Button>
                                                        <Button Classes="seg" Command="{Binding SetDockRetractDelayCommand}" CommandParameter="420">
                                                            <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                <TextBlock Text="标准" Classes="mode-label" Foreground="{Binding DockRetractDelayMs, Converter={x:Static vm:EqualsToTextBrushConverter.SettingsInstance}, ConverterParameter=420}"/>
                                                            </controls:ContinuousBorder>
                                                        </Button>
                                                        <Button Classes="seg" Command="{Binding SetDockRetractDelayCommand}" CommandParameter="800">
                                                            <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                <TextBlock Text="从容" Classes="mode-label" Foreground="{Binding DockRetractDelayMs, Converter={x:Static vm:EqualsToTextBrushConverter.SettingsInstance}, ConverterParameter=800}"/>
                                                            </controls:ContinuousBorder>
                                                        </Button>
                                                    </controls:SegmentPanel>
                                                </controls:AnimatedSegmentTrack>
                                            </Grid>
                                        </StackPanel>
                                    </controls:ContinuousBorder>
                                </StackPanel>
                                <StackPanel Spacing="{StaticResource Space.Sm}" IsVisible="{Binding ShowMemoryNote}">
                                    <TextBlock Classes="settings-group-label" Text="参数记忆"/>
                                    <controls:ContinuousBorder Classes="settings-section">
                                        <TextBlock Classes="settings-caption" Text="输出位置、格式、质量等参数自动保存，清空也会记住。"/>
                                    </controls:ContinuousBorder>
                                </StackPanel>
                                <StackPanel Spacing="{StaticResource Space.Sm}" IsVisible="{Binding ShowPhotoshopCard}">
                                    <TextBlock Classes="settings-group-label" Text="Photoshop"/>
                                    <controls:ContinuousBorder Classes="settings-section">
                                        <StackPanel>
                                            <Grid Classes="settings-row" IsVisible="{Binding ShowSyncSetting}" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <TextBlock Text="自动同步" Classes="setting-label" VerticalAlignment="Center" ToolTip.Tip="置顶时按 Photoshop 文档变化自动同步；未置顶时在窗口获得焦点后同步。收纳、最小化及导出期间暂停，不定时轮询、不打开外部脚本。"/>
                                                <Panel Grid.Column="1">
                                                    <controls:AnimatedSegmentTrack Classes="choice-track" SelectionValue="{Binding AutoRefreshOnActivated}">
                                                        <controls:SegmentPanel>
                                                            <Button Classes="seg" Command="{Binding SetAutoRefreshOnActivatedCommand}" CommandParameter="False" AutomationProperties.Name="自动同步：关闭">
                                                                <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                    <TextBlock Text="关闭" Classes="mode-label" Foreground="{Binding AutoRefreshOnActivated, Converter={x:Static vm:EqualsToTextBrushConverter.SettingsInstance}, ConverterParameter=False}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>
                                                            <Button Classes="seg" Command="{Binding SetAutoRefreshOnActivatedCommand}" CommandParameter="True" AutomationProperties.Name="自动同步：开启">
                                                                <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                    <TextBlock Text="开启" Classes="mode-label" Foreground="{Binding AutoRefreshOnActivated, Converter={x:Static vm:EqualsToTextBrushConverter.SettingsInstance}, ConverterParameter=True}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>
                                                        </controls:SegmentPanel>
                                                    </controls:AnimatedSegmentTrack>
                                                </Panel>
                                            </Grid>
                                        </StackPanel>
                                    </controls:ContinuousBorder>
                                </StackPanel>
                                <StackPanel Spacing="{StaticResource Space.Sm}" IsVisible="{Binding ShowUpdateCard}">
                                    <TextBlock Classes="settings-group-label" Text="更新"/>
                                    <controls:ContinuousBorder Classes="settings-section">
                                        <StackPanel>
                                            <Grid Classes="settings-row" IsVisible="{Binding ShowCheckSetting}" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <TextBlock Text="自动检测" Classes="setting-label" VerticalAlignment="Center" ToolTip.Tip="启动后及每 6 小时检查一次。"/>
                                                <Panel Grid.Column="1">
                                                    <controls:AnimatedSegmentTrack Classes="choice-track" SelectionValue="{Binding AutoCheckForUpdates}">
                                                        <controls:SegmentPanel>
                                                            <Button Classes="seg" Command="{Binding SetAutoCheckForUpdatesCommand}" CommandParameter="False" AutomationProperties.Name="自动检测：关闭">
                                                                <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                    <TextBlock Text="关闭" Classes="mode-label" Foreground="{Binding AutoCheckForUpdates, Converter={x:Static vm:EqualsToTextBrushConverter.SettingsInstance}, ConverterParameter=False}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>
                                                            <Button Classes="seg" Command="{Binding SetAutoCheckForUpdatesCommand}" CommandParameter="True" AutomationProperties.Name="自动检测：开启">
                                                                <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                    <TextBlock Text="开启" Classes="mode-label" Foreground="{Binding AutoCheckForUpdates, Converter={x:Static vm:EqualsToTextBrushConverter.SettingsInstance}, ConverterParameter=True}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>
                                                        </controls:SegmentPanel>
                                                    </controls:AnimatedSegmentTrack>
                                                </Panel>
                                            </Grid>
                                            <controls:ContinuousBorder Classes="settings-separator" IsVisible="{Binding ShowCheckDownloadLine}"/>
                                            <Grid Classes="settings-row" IsVisible="{Binding ShowDownloadSetting}" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <TextBlock Text="后台下载" Classes="setting-label" VerticalAlignment="Center" ToolTip.Tip="下载并校验后，由你确认重启安装。"/>
                                                <Panel Grid.Column="1">
                                                    <controls:AnimatedSegmentTrack Classes="choice-track" SelectionValue="{Binding AutoDownloadUpdates}">
                                                        <controls:SegmentPanel>
                                                            <Button Classes="seg" Command="{Binding SetAutoDownloadUpdatesCommand}" CommandParameter="False" AutomationProperties.Name="后台下载：关闭">
                                                                <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                    <TextBlock Text="关闭" Classes="mode-label" Foreground="{Binding AutoDownloadUpdates, Converter={x:Static vm:EqualsToTextBrushConverter.SettingsInstance}, ConverterParameter=False}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>
                                                            <Button Classes="seg" Command="{Binding SetAutoDownloadUpdatesCommand}" CommandParameter="True" AutomationProperties.Name="后台下载：开启">
                                                                <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                    <TextBlock Text="开启" Classes="mode-label" Foreground="{Binding AutoDownloadUpdates, Converter={x:Static vm:EqualsToTextBrushConverter.SettingsInstance}, ConverterParameter=True}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>
                                                        </controls:SegmentPanel>
                                                    </controls:AnimatedSegmentTrack>
                                                </Panel>
                                            </Grid>
                                            <controls:ContinuousBorder Classes="settings-separator" IsVisible="{Binding ShowDownloadVersionLine}"/>
                                            <!-- 托盘"检查更新"按这个名字滚动定位，改名会让入口失效。 -->
                                            <StackPanel x:Name="SettingsVersionCard" Spacing="8" IsVisible="{Binding ShowVersionCard}">
                                                <Grid Classes="settings-row" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                    <TextBlock Text="当前版本" Classes="setting-label" VerticalAlignment="Center"/>
                                                    <controls:ContinuousBorder Grid.Column="1" Background="{DynamicResource Brush.SettingsTrack}" CornerRadius="{StaticResource Radius.SegmentInner}" Padding="8,4" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding UpdateVersionLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}"/>
                                                    </controls:ContinuousBorder>
                                                </Grid>
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinHeight="32">
                                                    <TextBlock Text="{Binding UpdateStatus}" Classes="setting-description" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Classes="secondary settings-check-action" Content="检查更新" Command="{Binding CheckForUpdatesCommand}"/>
                                                </Grid>
                                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding UpdateProgress}" IsVisible="{Binding IsUpdateBusy}" Height="4"/>
                                                <StackPanel Spacing="8" IsVisible="{Binding HasUpdateChangelog}">
                                                    <controls:ContinuousBorder Classes="settings-separator"/>
                                                    <TextBlock Text="更新内容" Classes="setting-label"/>
                                                    <ScrollViewer MaxHeight="140" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                        <TextBlock Text="{Binding UpdateChangelog}" Classes="setting-description" TextWrapping="Wrap"/>
                                                    </ScrollViewer>
                                                </StackPanel>
                                                <Button Classes="primary settings-update-action" Content="{Binding UpdateActionText}" Command="{Binding ApplyUpdateCommand}"
                                                    HorizontalAlignment="Right" IsVisible="{Binding IsUpdateAvailable}"/>
                                                <TextBlock Text="确认重启后安装；导出期间暂不安装。" Classes="settings-caption" IsVisible="{Binding IsUpdateAvailable}" ToolTip.Tip="更新会校验文件并保留旧版备份。"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </controls:ContinuousBorder>
                                </StackPanel>
                                <StackPanel Spacing="{StaticResource Space.Sm}" IsVisible="{Binding ShowDataCard}">
                                    <TextBlock Classes="settings-group-label" Text="数据与日志"/>
                                    <controls:ContinuousBorder Classes="settings-section">
                                        <StackPanel>
                                            <Grid Classes="settings-row settings-directory-row" IsVisible="{Binding ShowDataSetting}" ColumnDefinitions="*,112" ColumnSpacing="12">
                                                <StackPanel Spacing="2" VerticalAlignment="Center" ToolTip.Tip="{Binding DataDirectory}">
                                                    <TextBlock Text="设置目录" Classes="setting-label"/>
                                                    <TextBlock Text="偏好与默认参数" Classes="settings-caption directory-caption"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="secondary settings-directory-action" Command="{Binding OpenDataDirectoryCommand}"
                                                    Content="打开文件夹" ToolTip.Tip="{Binding DataDirectory}" AutomationProperties.Name="打开设置目录"/>
                                            </Grid>
                                            <controls:ContinuousBorder Classes="settings-separator" IsVisible="{Binding ShowDataLogLine}"/>
                                            <Grid Classes="settings-row settings-directory-row" IsVisible="{Binding ShowLogSetting}" ColumnDefinitions="*,112" ColumnSpacing="12">
                                                <StackPanel Spacing="2" VerticalAlignment="Center" ToolTip.Tip="{Binding LogFilePath}">
                                                    <TextBlock Text="日志目录" Classes="setting-label"/>
                                                    <TextBlock Text="运行及导出记录" Classes="settings-caption directory-caption"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="secondary settings-directory-action" Command="{Binding OpenLogDirectoryCommand}"
                                                    Content="打开文件夹" ToolTip.Tip="{Binding LogFilePath}" AutomationProperties.Name="打开日志目录"/>
                                            </Grid>
                                        </StackPanel>
                                    </controls:ContinuousBorder>
                                </StackPanel>
                                <controls:ContinuousBorder Classes="settings-section" IsVisible="{Binding HasNoSettingsSearchResults}" Padding="20,26">
                                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                                        <TextBlock Text="没有找到相关设置" FontWeight="SemiBold" TextAlignment="Center"/>
                                        <TextBlock Text="试试“主题”“托盘”或“更新”" Classes="settings-caption" TextAlignment="Center"/>
                                        <Button Content="清空搜索" Command="{Binding ClearSettingsSearchCommand}" Click="OnClearSettingsSearchClick" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </controls:ContinuousBorder>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Grid.Row="3" Spacing="8" Margin="16,0">
                            <controls:ContinuousBorder Classes="settings-separator"/>
                            <TextBlock Text="{Binding SettingsStatusText}" Classes="settings-caption" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Footer actions only -->
                <controls:ContinuousBorder Grid.Row="4"
                        IsVisible="{Binding !IsViewSetting}"
                        Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Divider}"
                        BorderThickness="0,1,0,0"
                        Padding="16,12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Button Classes="secondary"
                                    Command="{Binding OpenExportFolderCommand}"
                                    IsVisible="{Binding CanOpenExportFolder}"
                                    ToolTip.Tip="在资源管理器中打开导出目录">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{StaticResource Icon.Folder}" Classes="icon" VerticalAlignment="Center"/>
                                    <TextBlock Text="打开目录" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="primary"
                                    Command="{Binding StartExportCommand}"
                                    IsVisible="{Binding !IsExporting}"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.Sm}">
                                    <TextBlock Text="{StaticResource Icon.Play}" Classes="icon" VerticalAlignment="Center"/>
                                    <TextBlock Text="开始导出" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="secondary"
                                    Command="{Binding CancelExportCommand}"
                                    IsVisible="{Binding IsExporting}"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="停止等待当前任务；Photoshop 可能仍会继续处理">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.Sm}">
                                    <TextBlock Text="{StaticResource Icon.Stop}" Classes="icon" VerticalAlignment="Center"/>
                                    <TextBlock Text="停止等待" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </controls:ContinuousBorder>
                <!-- 描边只绘制，不挤占标题栏布局；按钮背景可延伸到右上边缘。 -->
                <controls:ContinuousBorder Grid.RowSpan="5" ZIndex="50" IsHitTestVisible="False"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Lg}"/>
            </Grid>
        </controls:ContinuousBorder>

        <!-- Resize hit areas straddle the visible surface edge, inside the shadow margin. -->
        <Grid Margin="8">
            <controls:ContinuousBorder Height="6" VerticalAlignment="Top" Background="Transparent" ZIndex="1000"
                chrome:WindowDecorationProperties.ElementRole="ResizeN"/>
            <controls:ContinuousBorder Height="6" VerticalAlignment="Bottom" Background="Transparent" ZIndex="1000"
                chrome:WindowDecorationProperties.ElementRole="ResizeS"/>
            <controls:ContinuousBorder Width="6" HorizontalAlignment="Left" Background="Transparent" ZIndex="1000"
                chrome:WindowDecorationProperties.ElementRole="ResizeW"/>
            <controls:ContinuousBorder Width="6" HorizontalAlignment="Right" Background="Transparent" ZIndex="1000"
                chrome:WindowDecorationProperties.ElementRole="ResizeE"/>
            <controls:ContinuousBorder Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" ZIndex="1001"
                chrome:WindowDecorationProperties.ElementRole="ResizeNW"/>
            <controls:ContinuousBorder Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" ZIndex="1001"
                chrome:WindowDecorationProperties.ElementRole="ResizeNE"/>
            <controls:ContinuousBorder Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" ZIndex="1001"
                chrome:WindowDecorationProperties.ElementRole="ResizeSW"/>
            <controls:ContinuousBorder Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" ZIndex="1001"
                chrome:WindowDecorationProperties.ElementRole="ResizeSE"/>
        </Grid>
    </Grid>
        <!-- 与真实控件共用同一个 HWND；末尾在同一批次内换回 RootGrid。 -->
        <controls:GenieMeshControl x:Name="DockAnimationSurface"
                                  IsVisible="False" IsHitTestVisible="False"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    </Grid>
</Window>
