// 明确等待整张画布副本保存，不使用提前返回的 Export As 后台任务。
const { app, core } = require("photoshop");
async function runExport() {
    if (app.documents.length === 0) throw new Error("没有打开的文档");
    const exportPath = "{{EXPORT_PATH}}";
    const format = "{{FORMAT}}".toLowerCase();
    const quality = {{QUALITY}};
    const started = Date.now();
    const timings = {};
    let sourceDocument;
    await core.executeAsModal(async () => {
        timings.modalWaitMs = Date.now() - started;
        const prepareStarted = Date.now();
        const doc = app.activeDocument;
        sourceDocument = getExportSource(doc);
        const rawPath = exportPath.replace(/\\/g, "/").replace(/\/$/, "");
        const folderUrl = rawPath.startsWith("//") ? ("file:" + rawPath) : ("file:/" + rawPath.replace(/^\//, ""));
        const folder = await require("uxp").storage.localFileSystem.getEntryWithUrl(folderUrl);
        const name = psxSafeName(doc.name.replace(/\.[^.]+$/, ""), "export");
        const entry = await folder.createFile(name + "." + format, { overwrite: true });
        timings.prepareFileMs = Date.now() - prepareStarted;
        const saveStarted = Date.now();
        if (format === "png") await doc.saveAs.png(entry, {}, true);
        else if (format === "jpg") await doc.saveAs.jpg(entry, { quality: Math.round(12 * quality / 100) }, true);
        else throw new Error("不支持的导出格式: " + format);
        timings.saveMs = Date.now() - saveStarted;
    }, { commandName: "Export Canvas" });
    timings.totalMs = Date.now() - started;
    return { sourceDocument, timings };
}
